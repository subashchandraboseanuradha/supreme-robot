<?xml version="1.0" ?>
<robot name="ROS2" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find ROS2_description)/urdf/materials.xacro" />
<xacro:include filename="$(find ROS2_description)/urdf/ROS2.ros2control" />
<xacro:include filename="$(find ROS2_description)/urdf/ROS2.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="-0.0002500328650580711 -0.00011734629370466364 0.0780053653961204" rpy="0 0 0"/>
    <mass value="1.9745255969487336"/>
    <inertia ixx="0.022181" iyy="0.02888" izz="0.045008" ixy="0.0" iyz="2e-06" ixz="-0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ROS2_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="file://$(find ROS2_description)/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

