<joint name="camera_joint" type="fixed">
  <origin xyz="0.169576 0.011593 0.082626" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="camera_1"/>
</joint>

<joint name="lidar_joint" type="fixed">
  <origin xyz="0.143701 0.025838 0.13" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="lidar_1"/>
</joint>

<joint name="right_wheel_joint" type="continuous">
  <origin xyz="-0.000151 -0.142653 0.0555" rpy="0 0 0"/>
